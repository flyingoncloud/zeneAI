# Nginx Configuration for www.zeneme.ai
# This handles HTTPS, reverse proxy, and serves both frontend and backend

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name www.zeneme.ai zeneme.ai;

    # Redirect all HTTP requests to HTTPS
    return 301 https://$server_name$request_uri;
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.zeneme.ai zeneme.ai;

    # SSL Certificate (Let's Encrypt)
    # Generate with: sudo certbot --nginx -d www.zeneme.ai -d zeneme.ai
    ssl_certificate /etc/letsencrypt/live/www.zeneme.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.zeneme.ai/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Max upload size (for image uploads)
    client_max_body_size 10M;

    # Logs
    access_log /var/log/nginx/zeneme-access.log;
    error_log /var/log/nginx/zeneme-error.log;

    # Backend API - proxy to FastAPI on port 8000
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeouts for long-running requests
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Backend endpoints without /api prefix (for backward compatibility)
    location ~ ^/(chat|conversations|questionnaires|auth|upload|analyze|reports)/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Static files from backend (uploads, charts)
    location /uploads/ {
        alias /home/ubuntu/zeneAI/ai-chat-api/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /charts/ {
        alias /home/ubuntu/zeneAI/ai-chat-api/reports/charts/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Frontend - proxy to Next.js on port 3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Next.js static files
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }
}
