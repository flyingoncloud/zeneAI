# Production Environment Configuration for www.zeneme.ai
# Copy this file to .env on your EC2 instance and update the values

# ============================================================================
# Production Mode (REQUIRED)
# ============================================================================
PRODUCTION_MODE=true

# ============================================================================
# CORS Configuration (REQUIRED)
# ============================================================================
# Only include HTTPS domains in production
# Remove http:// variants and localhost entries
CORS_ORIGINS=https://www.zeneme.ai,https://zeneme.ai

# ============================================================================
# OpenAI API Key (REQUIRED)
# ============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================
DATABASE_URL=postgresql://chat_user:chat_pass@localhost:5432/chat_db

# ============================================================================
# API Settings
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# SMS Provider (Twilio)
# ============================================================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# ============================================================================
# Email Provider (SendGrid)
# ============================================================================
# Use 'console' for testing, 'sendgrid' for production
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@zeneme.com

# ============================================================================
# WeChat OAuth (Optional - for WeChat login)
# ============================================================================
# WECHAT_APP_ID=your_wechat_app_id
# WECHAT_APP_SECRET=your_wechat_app_secret
# WECHAT_REDIRECT_URI=https://www.zeneme.ai/auth/wechat/callback

# ============================================================================
# AI Response Settings
# ============================================================================
AI_RESPONSE_LANGUAGE=chinese
AI_FORCE_LANGUAGE=true
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1500

# ============================================================================
# Notes
# ============================================================================
# 1. Never commit this file with real credentials to git
# 2. Use HTTPS domains only in CORS_ORIGINS for production
# 3. Ensure SendGrid sender email is verified before using EMAIL_PROVIDER=sendgrid
# 4. Restart the backend after changing environment variables: sudo systemctl restart zeneme-backend
