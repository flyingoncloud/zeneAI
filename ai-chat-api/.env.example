# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here

# Database
DATABASE_URL=postgresql://chat_user:chat_pass@localhost:5432/chat_db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Language Settings
AI_RESPONSE_LANGUAGE=chinese
AI_FORCE_LANGUAGE=false

# Response Tuning
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1500
AI_PRESENCE_PENALTY=0.3
AI_FREQUENCY_PENALTY=0.3

# SMS Provider Configuration
# Options: console (dev), twilio, aws_sns, alibaba, messagebird
SMS_PROVIDER=console

# Twilio Configuration (for SMS verification)
# Get credentials from: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_number

# Email Provider Configuration
# Options: console (dev), sendgrid, aws_ses, smtp
EMAIL_PROVIDER=console

# SendGrid Configuration (for email verification)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# WeChat OAuth Configuration
# Register at: https://open.weixin.qq.com/
# Get AppID and AppSecret from WeChat Open Platform
# WECHAT_APP_ID=your_wechat_app_id
# WECHAT_APP_SECRET=your_wechat_app_secret
# WECHAT_REDIRECT_URI=http://localhost:3000/auth/wechat/callback
