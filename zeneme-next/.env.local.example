# Frontend Production Environment Configuration
# Copy this file to .env.local and update the values

# ============================================================================
# Production Mode (REQUIRED for production deployment)
# ============================================================================
NEXT_PUBLIC_PRODUCTION_MODE=true

# ============================================================================
# API Configuration (REQUIRED)
# ============================================================================
# Backend API URL - use your EC2 backend URL or domain
# Examples:
#   - Same server: http://www.zeneme.ai:8000
#   - Separate API domain: https://api.zeneme.ai
#   - EC2 IP: http://13.55.236.142:8000
NEXT_PUBLIC_API_URL=http://www.zeneme.ai:8000

# ============================================================================
# Frontend URL (REQUIRED for OAuth callbacks)
# ============================================================================
NEXT_PUBLIC_FRONTEND_URL=https://www.zeneme.ai

# ============================================================================
# Notes
# ============================================================================
# 1. For development, remove or set NEXT_PUBLIC_PRODUCTION_MODE=false
# 2. If backend is on same server, use: http://www.zeneme.ai:8000
# 3. If backend is on different domain, use: https://api.zeneme.ai
# 4. Restart Next.js after changing: npm run build && npm start

# ============================================================================
# Google OAuth (REQUIRED for Google login)
# ============================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
